    { "atS": 0, "text": "A push: GitLab creates 20 jobs in five stages." },
    { "atS": 0.7, "text": "Each job's event reaches the dispatcher. Eight jobs without needs start at once, each in a lane of its image." },
    { "atS": 14.9, "text": "The lanes pull their images and run: checks and tests side by side, each billed per second." },
    { "atS": 102.1, "text": "site-image-dev needs Docker and no VM is up: the dispatcher starts one." },
    { "atS": 172.3, "text": "The VM is up after 70 s and takes site-image-dev." },
    { "atS": 244.6, "text": "deploy-site-dev follows on the VM; verify-site-dev and monitor-site-dev check the site from lanes." },
    { "atS": 332.6, "text": "rust-test and ts-test passed: four Playwright jobs get lanes, build-image the warm VM." },
    { "atS": 403.4, "text": "A lane whose job is done waits 60 s for another job of its image, then ends." },
    { "atS": 653.5, "text": "build-image runs for ten minutes on the VM while the e2e jobs finish." },
    { "atS": 956.3, "text": "stack-test and deploy-dev follow on the same VM." },
    { "atS": 1058.0, "text": "verify-dev and monitor-dev check the deployment from lanes." },
    { "atS": 1137.9, "text": "Pipeline done after 19 minutes." },
